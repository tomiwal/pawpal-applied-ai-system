classDiagram
    class Owner {
        +str name
        +list preferences
        +int time_available_minutes
        +void add_preference(preference: str)
        +list get_preferences()
    }

    class Pet {
        +str name
        +str species
        +int age
        +list special_needs
        +list get_special_needs()
    }

    class Task {
        +str title
        +str priority
        +int duration_minutes
        +str frequency
        +int get_priority_value()
        +bool is_due_today()
    }

    class Schedule {
        +str day
        +list tasks
        +int total_time_minutes
        +void add_task(task: Task)
        +int get_total_duration()
    }

    class Scheduler {
        +Owner owner
        +list pets
        +list available_tasks
        +Schedule generate_plan(pet: Pet)
        +list sort_tasks_by_priority(tasks: list)
    }

    Owner --> Pet : owns
    Pet --> Task : has_tasks
    Scheduler --> Owner : schedules_for
    Scheduler --> Pet : plans_for
    Scheduler --> Schedule : creates
    Schedule --> Task : contains
